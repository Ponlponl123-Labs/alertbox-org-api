generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique @db.VarChar(256)
  createWith      String           @db.VarChar(50)
  secret          String           @unique @db.VarChar(255)
  disabledAt      DateTime?        @db.Timestamp(0)
  deletedAt       DateTime?        @db.Timestamp(0)
  createdAt       DateTime         @default(now()) @db.Timestamp(0)
  updatedAt       DateTime         @updatedAt @db.Timestamp(0)
  integration     Integration?
  profile         Profile?
  reservedUris    ReservedUri[]
  sessions        Session[]        @relation("UserSessions")
  sessionUsages   SessionUsage[]
  transactionLogs TransactionLog[]
  streamlabsRelayLogs StreamlabsRelayLog[]
  widgets         Widget[]

  @@unique([id, secret])
  @@index([email])
}

model Profile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  name                   String    @db.VarChar(64)
  displayName            String    @db.VarChar(64)
  bio                    String?   @db.Text
  avatar                 String?   @db.VarChar(512)
  banner                 String?   @db.VarChar(512)
  options                Int       @default(0) @db.UnsignedInt
  badges                 Int       @default(0) @db.UnsignedInt
  accentColor            Int       @default(0) @db.UnsignedInt
  uri                    String?   @unique @db.VarChar(64)
  uriCooldownEnd         DateTime? @db.Timestamp(0)
  publishedAt            DateTime? @db.Timestamp(0)
  twitch                 String?   @db.VarChar(48)
  youtube                String?   @db.VarChar(48)
  twitter                String?   @db.VarChar(48)
  facebook               String?   @db.VarChar(64)
  reddit                 String?   @db.VarChar(48)
  discord                String?   @db.VarChar(32)
  defaultDonorName       String    @default("Anonymous") @db.VarChar(48)
  defaultDonorAmount     Int       @default(1) @db.UnsignedSmallInt
  defaultDonorAvatar     String?   @db.VarChar(512)
  isDonorCanCustomAvatar DateTime? @default(now()) @db.Timestamp(0)
  currency               Int?      @db.UnsignedSmallInt
  minTipAmount           Int       @default(1) @db.UnsignedSmallInt
  maxTipAmount           Int       @default(10000) @db.UnsignedSmallInt
  deletedAt              DateTime? @db.Timestamp(0)
  createdAt              DateTime  @default(now()) @db.Timestamp(0)
  updatedAt              DateTime  @updatedAt @db.Timestamp(0)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
  @@index([uri])
  @@fulltext([bio])
}

model Widget {
  id        String           @id @default(cuid())
  userId    String
  type      WidgetType
  token     String           @unique @db.VarChar(255)
  deletedAt DateTime?        @db.Timestamp(0)
  createdAt DateTime         @default(now()) @db.Timestamp(0)
  updatedAt DateTime         @updatedAt @db.Timestamp(0)
  alertbox  AlertboxSetting?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenLogs WidgetTokenLog[]

  @@index([userId])
}

model AlertboxSetting {
  id           String          @id @default(cuid())
  widgetId     String          @unique
  globalVolume Float           @default(0.5) @db.Float
  events       AlertboxEvent[]
  widget       Widget          @relation(fields: [widgetId], references: [id], onDelete: Cascade)
}

model AlertboxEvent {
  id                 String          @id @default(cuid())
  alertboxId         String
  eventType          AlertEventType
  isEnabled          Boolean         @default(true)
  prefix             String?         @db.VarChar(64)
  subfix             String?         @db.VarChar(64)
  messageLayout      String?         @default("image-above") @db.VarChar(32)
  minVisibleDuration Float           @default(3) @db.Float
  animIn             String?         @default("fade_in_up") @db.VarChar(64)
  animOut            String?         @default("fade_out_up") @db.VarChar(64)
  animInDuration     Float           @default(1) @db.Float
  animOutDuration    Float           @default(1) @db.Float
  image              String?         @db.VarChar(512)
  sound              String?         @db.VarChar(512)
  soundVolume        Float           @default(0.5) @db.Float
  fontFamily         String?         @default("Open Sans") @db.VarChar(64)
  fontSize           Int             @default(32) @db.UnsignedTinyInt
  fontWeight         Int             @default(600) @db.UnsignedSmallInt
  textColor          Int             @default(16777215) @db.UnsignedInt
  accentColor        Int             @default(6723532) @db.UnsignedInt
  subfixColor        Int             @default(13369548) @db.UnsignedInt
  donorColor         Int             @default(6723532) @db.UnsignedInt
  amountColor        Int             @default(13369548) @db.UnsignedInt
  textShadowColor    Int             @default(0) @db.UnsignedInt
  textShadowSize     Int             @default(0) @db.UnsignedTinyInt
  outlineColor       Int             @default(0) @db.UnsignedInt
  outlineSize        Int             @default(3) @db.UnsignedTinyInt
  ttsEnabled         Boolean         @default(false)
  ttsMinTip          Int             @default(0) @db.UnsignedSmallInt
  ttsVoice           String?         @db.VarChar(64)
  ttsVolume          Float           @default(0.5) @db.Float
  ttsSpeed           Float           @default(0.5) @db.Float
  ttsPitch           Float           @default(0.5) @db.Float
  ttsDelay           Float           @default(0) @db.Float
  ttsOptions         Int             @default(0) @db.UnsignedInt
  updatedAt          DateTime        @updatedAt @db.Timestamp(0)
  alertbox           AlertboxSetting @relation(fields: [alertboxId], references: [id], onDelete: Cascade)

  @@unique([alertboxId, eventType])
}

model Integration {
  id                String    @id @default(cuid())
  userId            String    @unique
  stripeSecret      String?   @db.VarChar(512)
  stripeOptions     Int       @default(0) @db.UnsignedInt
  bmacSecret        String?   @db.VarChar(512)
  bmacOptions       Int       @default(0) @db.UnsignedInt
  kofiSecret        String?   @db.VarChar(512)
  kofiOptions       Int       @default(0) @db.UnsignedInt
  xenditSecret      String?   @db.VarChar(512)
  xenditOptions     Int       @default(0) @db.UnsignedInt
  ffpSecret         String?   @db.VarChar(512)
  ffpOptions        Int       @default(0) @db.UnsignedInt
  streamlabsSecret        String?   @db.VarChar(2048)
  streamlabsRefreshToken  String?   @db.VarChar(2048)
  streamlabsOptions       Int       @default(0) @db.UnsignedInt
  deletedAt         DateTime? @db.Timestamp(0)
  updatedAt         DateTime  @updatedAt @db.Timestamp(0)
  bmacUsername      String?   @db.VarChar(64)
  kofiUsername      String?   @db.VarChar(64)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id              String         @id @default(cuid())
  userId          String
  userSecret      String         @db.VarChar(255)
  token           String         @unique @db.VarChar(255)
  method          String         @db.VarChar(255)
  userAgent       String         @db.LongText
  os              String?        @db.VarChar(128)
  osVersion       String?        @db.VarChar(128)
  platform        String?        @db.VarChar(128)
  platformType    String?        @db.VarChar(128)
  platformMajor   String?        @db.VarChar(128)
  platformVersion String?        @db.VarChar(128)
  deviceModel     String?        @db.VarChar(128)
  deviceType      String?        @db.VarChar(128)
  deviceVendor    String?        @db.VarChar(128)
  cpuArchitecture String?        @db.VarChar(128)
  ipAddress       String         @db.VarChar(50)
  country         String?        @db.VarChar(64)
  countryCode     String?        @db.VarChar(2)
  countryCodeIso3 String?        @db.VarChar(3)
  continentCode   String?        @db.VarChar(3)
  postal          String?        @db.VarChar(32)
  city            String?        @db.VarChar(512)
  region          String?        @db.VarChar(512)
  regionCode      String?        @db.VarChar(3)
  latitude        Decimal?       @db.Decimal(9, 6)
  longitude       Decimal?       @db.Decimal(9, 6)
  isp             String?        @db.VarChar(512)
  asn             String?        @db.VarChar(50)
  expiresAt       DateTime       @default(now()) @db.Timestamp(0)
  disabledAt      DateTime?      @db.Timestamp(0)
  deletedAt       DateTime?      @db.Timestamp(0)
  createdAt       DateTime       @default(now()) @db.Timestamp(0)
  user            User           @relation("UserSessions", fields: [userId, userSecret], references: [id, secret], onDelete: Cascade)
  sessionUsages   SessionUsage[]

  @@index([userId, userSecret])
}

model SessionUsage {
  id        String    @id @default(cuid())
  sessionId String
  userId    String
  ipAddress String    @db.VarChar(50)
  deletedAt DateTime? @db.Timestamp(0)
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

model ReservedUri {
  id              String    @id @default(cuid())
  userId          String
  uri             String    @unique @db.VarChar(50)
  reservedByToken String    @db.VarChar(255)
  disabledAt      DateTime? @db.Timestamp(0)
  deletedAt       DateTime? @db.Timestamp(0)
  createdAt       DateTime  @default(now()) @db.Timestamp(0)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TransactionLog {
  id           String            @id @default(cuid())
  userId       String
  provider     String            @db.VarChar(50)
  providerTxId String?           @db.VarChar(255)
  type         AlertEventType
  status       TransactionStatus @default(PENDING)
  isTest       Boolean           @default(false)
  amount       Int               @db.UnsignedInt
  currency     String            @db.VarChar(10)
  senderName   String            @default("Anonymous") @db.VarChar(64)
  senderEmail  String?           @db.VarChar(256)
  message      String?           @db.Text
  rawPayload   String?           @db.LongText
  createdAt    DateTime          @default(now()) @db.Timestamp(0)
  updatedAt    DateTime          @updatedAt @db.Timestamp(0)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerTxId])
  @@index([userId])
  @@index([createdAt])
}

enum WidgetType {
  ALERTBOX
  TIPJAR
  GOALBAR
}

enum AlertEventType {
  TIP
  MEMBERSHIP
  MERCH
  FOLLOW
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model WidgetTokenLog {
  id        String   @id @default(cuid())
  widgetId  String
  oldToken  String   @db.VarChar(255)
  newToken  String   @db.VarChar(255)
  ipAddress String   @db.VarChar(50)
  userAgent String   @db.LongText
  createdAt DateTime @default(now()) @db.Timestamp(0)
  widget    Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@index([widgetId])
  @@index([createdAt])
}

model StreamlabsRelayLog {
  id           String            @id @default(cuid())
  userId       String
  provider     String            @db.VarChar(50)
  providerTxId String?           @db.VarChar(255)
  type         AlertEventType
  status       TransactionStatus @default(PENDING)
  amount       Int               @db.UnsignedInt
  currency     String            @db.VarChar(10)
  senderName   String            @default("Anonymous") @db.VarChar(64)
  senderEmail  String?           @db.VarChar(256)
  message      String?           @db.Text
  errorMessage String?           @db.Text
  createdAt    DateTime          @default(now()) @db.Timestamp(0)
  updatedAt    DateTime          @updatedAt @db.Timestamp(0)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerTxId])
  @@index([userId])
  @@index([createdAt])
}

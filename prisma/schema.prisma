generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                 BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  email              String                 @unique @db.VarChar(256)
  type               UserType               @default(REGULAR)
  createWith         String                 @db.VarChar(50)
  secret             String                 @unique @db.VarChar(255)
  name               String?                @db.VarChar(64)
  avatar             String?                @db.VarChar(512)
  disabledAt         DateTime?              @db.Timestamp(0)
  deletedAt          DateTime?              @db.Timestamp(0)
  createdAt          DateTime               @default(now()) @db.Timestamp(0)
  updatedAt          DateTime               @updatedAt @db.Timestamp(0)
  sessions           Session[]              @relation("UserSessions")
  sessionUsages      SessionUsage[]
  ownedOrganizations   Organization[]         @relation("OrgOwner")
  createdOrganizations Organization[]         @relation("OrgCreator")
  memberships          OrganizationMember[]
  invitesSent          OrganizationInvite[]   @relation("OrgInviter")
  auditLogs            OrganizationAuditLog[]

  @@unique([id, secret])
}

model Organization {
  id                  BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  type                OrgType                @default(COMMUNITY)
  slug                String                 @unique @db.VarChar(50)
  name                String                 @db.VarChar(100)
  avatar              String?                @db.VarChar(512)
  banner              String?                @db.VarChar(512)
  ownerId             BigInt                 @db.UnsignedBigInt
  createBy            BigInt                 @db.UnsignedBigInt
  deletedAt           DateTime?              @db.Timestamp(0)
  createdAt           DateTime               @default(now()) @db.Timestamp(0)
  updatedAt           DateTime               @updatedAt @db.Timestamp(0)
  owner               User                   @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  creator             User                   @relation("OrgCreator", fields: [createBy], references: [id], onDelete: Restrict)
  members             OrganizationMember[]
  invites             OrganizationInvite[]
  rolePresets         OrganizationRolePreset[]
  streamers           Streamer[]
  widgets             Widget[]
  integrations        Integration[]
  transactionLogs     TransactionLog[]
  streamlabsRelayLogs StreamlabsRelayLog[]
  auditLogs           OrganizationAuditLog[]

  @@index([createBy])
  @@index([ownerId, deletedAt])
}

model OrganizationMember {
  id           BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  orgId        BigInt       @db.UnsignedBigInt
  userId       BigInt       @db.UnsignedBigInt
  role         OrgRole      @default(MEMBER)
  permissions  BigInt       @default(0) @db.UnsignedBigInt
  isDeleted    DateTime?    @db.DateTime(0)
  createdAt    DateTime     @default(now()) @db.Timestamp(0)
  updatedAt    DateTime     @updatedAt @db.Timestamp(0)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId, orgId])
  @@index([orgId, role])
}

enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  EDITOR
  VIEWER
  MEMBER
}

enum UserType {
  REGULAR
  SUPPORTER
  OPERATOR
}

enum OrgType {
  COMMUNITY
  ENTERPRISE
}

model OrganizationInvite {
  id           BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  orgId        BigInt       @db.UnsignedBigInt
  email        String       @db.VarChar(256)
  role         OrgRole      @default(MEMBER)
  permissions  BigInt       @default(0) @db.UnsignedBigInt
  token        String       @unique @db.VarChar(128)
  inviterId    BigInt       @db.UnsignedBigInt
  expiresAt    DateTime     @db.Timestamp(0)
  acceptedAt   DateTime?    @db.Timestamp(0)
  createdAt    DateTime     @default(now()) @db.Timestamp(0)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inviter      User         @relation("OrgInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([orgId, email])
}

model OrganizationAuditLog {
  id           BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  orgId        BigInt       @db.UnsignedBigInt
  userId       BigInt       @db.UnsignedBigInt
  action       String       @db.VarChar(64)
  targetType   String       @db.VarChar(32)
  targetId     BigInt?      @db.UnsignedBigInt
  payload      String?      @db.LongText
  ipAddress    String       @db.VarChar(50)
  createdAt    DateTime     @default(now()) @db.Timestamp(0)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, targetType, targetId, createdAt])
}

model Streamer {
  id                     BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  orgId                  BigInt               @db.UnsignedBigInt
  name                   String               @db.VarChar(64)
  displayName            String               @db.VarChar(64)
  bio                    String?              @db.Text
  avatar                 String?              @db.VarChar(512)
  banner                 String?              @db.VarChar(512)
  options                Int                  @default(0) @db.UnsignedInt
  badges                 Int                  @default(0) @db.UnsignedInt
  accentColor            Int                  @default(0) @db.UnsignedInt
  uri                    String?              @unique @db.VarChar(64)
  uriCooldownEnd         DateTime?            @db.Timestamp(0)
  publishedAt            DateTime?            @db.Timestamp(0)
  twitch                 String?              @db.VarChar(48)
  youtube                String?              @db.VarChar(48)
  twitter                String?              @db.VarChar(48)
  facebook               String?              @db.VarChar(64)
  reddit                 String?              @db.VarChar(48)
  discord                String?              @db.VarChar(32)
  defaultDonorName       String               @default("Anonymous") @db.VarChar(48)
  defaultDonorAmount     Int                  @default(1) @db.UnsignedSmallInt
  defaultDonorAvatar     String?              @db.VarChar(512)
  isDonorCanCustomAvatar DateTime?            @default(now()) @db.Timestamp(0)
  currency               Int?                 @db.UnsignedSmallInt
  minTipAmount           Int                  @default(1) @db.UnsignedSmallInt
  maxTipAmount           Int                  @default(10000) @db.UnsignedSmallInt
  deletedAt              DateTime?            @db.Timestamp(0)
  createdAt              DateTime             @default(now()) @db.Timestamp(0)
  updatedAt              DateTime             @updatedAt @db.Timestamp(0)
  organization           Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  integration            Integration?
  widgets                Widget[]
  reservedUris           ReservedUri[]
  transactionLogs        TransactionLog[]
  streamlabsRelayLogs    StreamlabsRelayLog[]

  @@index([orgId, deletedAt])
  @@index([displayName])
  @@fulltext([bio])
}

model Widget {
  id           BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  orgId        BigInt           @db.UnsignedBigInt
  streamerId   BigInt           @db.UnsignedBigInt
  type         WidgetType
  token        String           @unique @db.VarChar(255)
  deletedAt    DateTime?        @db.Timestamp(0)
  createdAt    DateTime         @default(now()) @db.Timestamp(0)
  updatedAt    DateTime         @updatedAt @db.Timestamp(0)
  alertbox     AlertboxSetting?
  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  streamer     Streamer         @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  tokenLogs    WidgetTokenLog[]

  @@index([streamerId, type, deletedAt])
  @@index([orgId, deletedAt])
}

model AlertboxSetting {
  id           BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  widgetId     BigInt          @unique @db.UnsignedBigInt
  globalVolume Int?            @default(50) @db.UnsignedTinyInt
  events       AlertboxEvent[]
  widget       Widget          @relation(fields: [widgetId], references: [id], onDelete: Cascade)
}

model AlertboxEvent {
  id                 BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  alertboxId         BigInt          @db.UnsignedBigInt
  eventType          AlertEventType
  isEnabled          Boolean         @default(true)
  prefix             String?         @db.VarChar(64)
  subfix             String?         @db.VarChar(64)
  messageLayout      Int?            @default(0) @db.UnsignedSmallInt
  minVisibleDuration Int?            @default(3000) @db.UnsignedSmallInt
  animIn             Int?            @default(0) @db.UnsignedSmallInt
  animOut            Int?            @default(1) @db.UnsignedSmallInt
  animInDuration     Int?            @default(1000) @db.UnsignedSmallInt
  animOutDuration    Int?            @default(1000) @db.UnsignedSmallInt
  image              String?         @db.VarChar(512)
  sound              String?         @db.VarChar(512)
  soundVolume        Int?            @default(50) @db.UnsignedTinyInt
  fontFamily         Int?            @default(0) @db.UnsignedTinyInt
  fontSize           Int             @default(20) @db.UnsignedTinyInt
  fontWeight         Int             @default(600) @db.UnsignedSmallInt
  textColor          Int             @default(16777215) @db.UnsignedInt
  accentColor        Int             @default(6723532) @db.UnsignedInt
  subfixColor        Int             @default(13369548) @db.UnsignedInt
  donorColor         Int             @default(6723532) @db.UnsignedInt
  amountColor        Int             @default(13369548) @db.UnsignedInt
  textShadowColor    Int             @default(0) @db.UnsignedInt
  textShadowSize     Int             @default(0) @db.UnsignedTinyInt
  outlineColor       Int             @default(0) @db.UnsignedInt
  outlineSize        Int             @default(3) @db.UnsignedTinyInt
  ttsEnabled         Boolean         @default(false)
  ttsMinTip          Int             @default(0) @db.UnsignedSmallInt
  ttsVoice           Int?            @default(0) @db.UnsignedTinyInt
  ttsVolume          Int?            @default(50) @db.UnsignedTinyInt
  ttsSpeed           Int?            @default(50) @db.UnsignedTinyInt
  ttsPitch           Int?            @default(50) @db.UnsignedTinyInt
  ttsDelay           Int?            @default(0) @db.UnsignedSmallInt
  ttsOptions         Int             @default(0) @db.UnsignedInt
  updatedAt          DateTime        @updatedAt @db.Timestamp(0)
  alertbox           AlertboxSetting @relation(fields: [alertboxId], references: [id], onDelete: Cascade)

  @@unique([alertboxId, eventType])
}

model Integration {
  id                     BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  orgId                  BigInt       @db.UnsignedBigInt
  streamerId             BigInt       @unique @db.UnsignedBigInt
  stripeSecret           String?      @db.VarChar(512)
  stripeOptions          Int          @default(0) @db.UnsignedInt
  bmacSecret             String?      @db.VarChar(512)
  bmacOptions            Int          @default(0) @db.UnsignedInt
  kofiSecret             String?      @db.VarChar(512)
  kofiOptions            Int          @default(0) @db.UnsignedInt
  xenditSecret           String?      @db.VarChar(512)
  xenditOptions          Int          @default(0) @db.UnsignedInt
  ffpSecret              String?      @db.VarChar(512)
  ffpOptions             Int          @default(0) @db.UnsignedInt
  streamlabsSecret       String?      @db.VarChar(2048)
  streamlabsRefreshToken String?      @db.VarChar(2048)
  streamlabsOptions      Int          @default(0) @db.UnsignedInt
  bmacUsername           String?      @db.VarChar(64)
  kofiUsername           String?      @db.VarChar(64)
  deletedAt              DateTime?    @db.Timestamp(0)
  updatedAt              DateTime     @updatedAt @db.Timestamp(0)
  organization           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  streamer               Streamer     @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@index([kofiSecret, deletedAt])
  @@index([bmacSecret, deletedAt])
  @@index([orgId, deletedAt])
}

model Session {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  userId          BigInt         @db.UnsignedBigInt
  userSecret      String         @db.VarChar(255)
  token           String         @unique @db.VarChar(255)
  method          String         @db.VarChar(255)
  userAgent       String         @db.Text
  os              String?        @db.VarChar(128)
  osVersion       String?        @db.VarChar(128)
  platform        String?        @db.VarChar(128)
  platformType    String?        @db.VarChar(128)
  platformMajor   String?        @db.VarChar(128)
  platformVersion String?        @db.VarChar(128)
  deviceModel     String?        @db.VarChar(128)
  deviceType      String?        @db.VarChar(128)
  deviceVendor    String?        @db.VarChar(128)
  cpuArchitecture String?        @db.VarChar(128)
  ipAddress       String         @db.VarChar(50)
  ipVersion       Int?           @db.TinyInt
  isMobile        Boolean?       @default(false) @db.TinyInt
  isProxy         Boolean?       @default(false) @db.TinyInt
  isHosting       Boolean?       @default(false) @db.TinyInt
  isAnonymous     Boolean?       @default(false) @db.TinyInt
  isAnycast       Boolean?       @default(false) @db.TinyInt
  isSatellite     Boolean?       @default(false) @db.TinyInt
  isRelay         Boolean?       @default(false) @db.TinyInt
  isTor           Boolean?       @default(false) @db.TinyInt
  isVpn           Boolean?       @default(false) @db.TinyInt
  isResProxy      Boolean?       @default(false) @db.TinyInt
  timezone        String?        @db.VarChar(128)
  country         String?        @db.VarChar(256)
  countryCode     String?        @db.VarChar(2)
  countryCodeIso3 String?        @db.VarChar(3)
  continent       String?        @db.VarChar(256)
  continentCode   String?        @db.VarChar(3)
  postal          String?        @db.VarChar(32)
  city            String?        @db.VarChar(512)
  region          String?        @db.VarChar(512)
  regionCode      String?        @db.VarChar(3)
  latitude        Decimal?       @db.Decimal(9, 6)
  longitude       Decimal?       @db.Decimal(9, 6)
  isp             String?        @db.VarChar(512)
  asn             String?        @db.VarChar(50)
  expiresAt       DateTime       @default(now()) @db.Timestamp(0)
  disabledAt      DateTime?      @db.Timestamp(0)
  deletedAt       DateTime?      @db.Timestamp(0)
  createdAt       DateTime       @default(now()) @db.Timestamp(0)
  user            User           @relation("UserSessions", fields: [userId, userSecret], references: [id, secret], onDelete: Cascade)
  sessionUsages   SessionUsage[]

  @@index([userId, userSecret])
  @@index([userId, disabledAt, expiresAt])
  @@index([expiresAt])
}

model SessionUsage {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  sessionId BigInt    @db.UnsignedBigInt
  userId    BigInt    @db.UnsignedBigInt
  ipAddress String    @db.VarChar(50)
  deletedAt DateTime? @db.Timestamp(0)
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId, id])
}

model ReservedUri {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  streamerId      BigInt    @db.UnsignedBigInt
  uri             String    @unique @db.VarChar(50)
  reservedByToken String    @db.VarChar(255)
  disabledAt      DateTime? @db.Timestamp(0)
  deletedAt       DateTime? @db.Timestamp(0)
  createdAt       DateTime  @default(now()) @db.Timestamp(0)
  streamer        Streamer  @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@index([streamerId, deletedAt, createdAt])
}

model WebhookLog {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  provider    String   @db.VarChar(100)
  eventType   String   @db.VarChar(50)
  rawPayload  String   @db.LongText
  status      String   @db.VarChar(50)
  processedAt DateTime @default(now()) @db.Timestamp(0)

  @@index([provider, processedAt])
  @@index([processedAt])
}

model TransactionLog {
  id           BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  orgId        BigInt            @db.UnsignedBigInt
  streamerId   BigInt            @db.UnsignedBigInt
  provider     String            @db.VarChar(50)
  providerTxId String?           @db.VarChar(255)
  type         AlertEventType
  status       TransactionStatus @default(PENDING)
  isTest       Boolean           @default(false)
  isDeleted    DateTime?         @db.Timestamp(0)
  amount       Int               @db.UnsignedInt
  currency     String            @db.VarChar(10)
  senderName   String            @default("Anonymous") @db.VarChar(64)
  senderEmail  String?           @db.VarChar(256)
  message      String?           @db.Text
  rawPayload   String?           @db.LongText
  createdAt    DateTime          @default(now()) @db.Timestamp(0)
  updatedAt    DateTime          @updatedAt @db.Timestamp(0)
  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  streamer     Streamer          @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerTxId])
  @@index([streamerId, createdAt])
  @@index([orgId, createdAt])
}

enum WidgetType {
  ALERTBOX
  TIPJAR
  GOALBAR
}

enum AlertEventType {
  TIP
  MEMBERSHIP
  MERCH
  FOLLOW
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model WidgetTokenLog {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  widgetId  BigInt   @db.UnsignedBigInt
  oldToken  String   @db.VarChar(255)
  newToken  String   @db.VarChar(255)
  ipAddress String   @db.VarChar(50)
  userAgent String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamp(0)
  widget    Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@index([widgetId, createdAt])
}

model StreamlabsRelayLog {
  id           BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  orgId        BigInt            @db.UnsignedBigInt
  streamerId   BigInt            @db.UnsignedBigInt
  provider     String            @db.VarChar(50)
  providerTxId String?           @db.VarChar(255)
  type         AlertEventType
  status       TransactionStatus @default(PENDING)
  amount       Int               @db.UnsignedInt
  currency     String            @db.VarChar(10)
  senderName   String            @default("Anonymous") @db.VarChar(64)
  senderEmail  String?           @db.VarChar(256)
  message      String?           @db.Text
  rawPayload   String?           @db.LongText
  errorMessage String?           @db.Text
  createdAt    DateTime          @default(now()) @db.Timestamp(0)
  updatedAt    DateTime          @updatedAt @db.Timestamp(0)
  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  streamer     Streamer          @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerTxId])
  @@index([streamerId, createdAt])
  @@index([orgId, createdAt])
}

model OrganizationRolePreset {
  id           BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  orgId        BigInt       @db.UnsignedBigInt
  name         String       @db.VarChar(64)
  description  String?      @db.VarChar(255)
  permissions  BigInt       @default(0) @db.UnsignedBigInt
  color        String?      @db.VarChar(255)
  createdAt    DateTime     @default(now()) @db.Timestamp(0)
  updatedAt    DateTime     @default(now()) @updatedAt @db.Timestamp(0)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}
